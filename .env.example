PAPER_TRACKER_DB=/data/papers.db
PAPER_TRACKER_USER=paper
PAPER_TRACKER_PASSWORD=change-this-password
PAPER_TRACKER_CRON_SECRET=change-this-cron-secret
PAPER_TRACKER_PUBLIC_URL=https://your-app.up.railway.app
PAPER_TRACKER_CRON_DAYS=14
PAPER_TRACKER_CRON_PER_PAGE=50
PAPER_TRACKER_CRON_PAGES=2
OPENALEX_MAILTO=you@example.com
PAPER_TRACKER_TRANSLATION_PROVIDER=auto
MYMEMORY_SOURCE_LANG=en
MYMEMORY_TARGET_LANG=zh-CN
MYMEMORY_EMAIL=you@example.com
# Optional, for higher-quality DeepL translations:
# DEEPL_API_KEY=your-deepl-api-key
# DEEPL_TARGET_LANG=ZH
# DEEPL_SOURCE_LANG=EN

# Optional email notifications for newly inserted papers:
# HTTPS email API, recommended on Railway:
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Paper Tracker <onboarding@resend.dev>

# SMTP fallback:
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-authorization-code
MAIL_FROM=you@example.com
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_SUBJECT_PREFIX=论文追索
NOTIFY_MAX_PAPERS=50
